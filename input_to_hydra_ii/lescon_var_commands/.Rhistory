library(data.table)
library(mgcv)
library(caret)
source("~/ENV-floodGAM/code/functions/fn_helper.R")
# Paths and constants -----------------------------------------------------
PROJECT_DIR <- "~/ENV-floodGAM"
OUTPUT_DIR <- file.path(PROJECT_DIR, "results/output/")
WHICH_DATA_DIR <- "ngc"
COVARIATE_FILE <- file.path(
PROJECT_DIR,
#"data/catchment_covariates_w_new_climate_normals.rds"
#"data/catchment_covariates_w_new_climate_and_geographic_covariates.rds"
"data/catchment_covariates_w_new_geographic_covariates.rds"
)
ANNUAL_MAX_FILE <- file.path(
PROJECT_DIR,
"data/annual_maxima.rds"
)
FOLD_MAP_FILE <- file.path(OUTPUT_DIR, "cv_fold_map_k10_ref24h.rds")
K_FOLDS <- 10 # kfold cross validation
# Data preparation --------------------------------------------------------
gfcov <- readRDS(COVARIATE_FILE) # covariates
gfam <- readRDS(ANNUAL_MAX_FILE) # annual maxima
gfam <- merge(gfam, gfcov[, .(ID, A)], by = "ID")
gfam[, specQ := Qm3_s / A * 1000]
gfam <- gfam[, .(qind = median(specQ)), by = .(ID, d)]
gfam[, log_qind := log(qind)]
gfcov[,log_R_G_1085:=log(R_G_1085+1)]
gfcov <- gfcov[, !c(
"Y_lat", "X_long", "Y_utm", "X_utm",
"Y_G_Lat", "X_G_Long", "Y_G_UTM", "X_G_UTM"
)]
gfcov <- standardize_by_two_sd(gfcov)
gamdat <- merge(gfcov, gfam, by = "ID")
# CV folds and model formulas --------------------------------------------
fold_map <- as.data.table(readRDS(FOLD_MAP_FILE))
# here are the configs for the interaction gams
base_formula <- "log_qind ~ s(Q_N, k = 7) + s(A_LE, k = 7) + s(A_P, k = 7) + s(H_F, k = 7) + s(log_R_G_1085, k = 7) + s(W_Apr, k = 4)"
config <- list(
M1 = as.formula(paste(base_formula, "+ s(P_Sep, k = 4) + s(D, k = 7)")),
M2 = as.formula(paste(base_formula, "+ s(P_Sep, k = 4) + ti(H_F, W_Apr, k = c(4,4))")),
M3 = as.formula(paste(base_formula, "+ s(P_Sep, k = 6) + ti(H_F, P_Sep, k = c(4,4))")),
M4 = as.formula(paste(base_formula, "+ s(P_Sep, k = 6) + ti(W_Apr, P_Sep, k = c(4,4))")),
M5 = as.formula(paste(base_formula, "+ s(P_Sep, k = 4) + ti(Q_N, A_LE, k = c(4,4))")),
M6 = as.formula(paste(base_formula, "+ s(P_Sep, k = 4) + s(D, k = 7) + ti(Q_N, D, k = c(4,4))"))
)
library(gratia)
plot_gamdat <- gamdat[d==1]
FG <- gam(
config[["M6"]],
method = "REML",
select = TRUE,
data = plot_gamdat,
family = gaussian(link = identity)
)
draw(FG)
FG <- gam(
config[["M6"]],
method = "REML",
data = plot_gamdat,
family = gaussian(link = identity)
)
draw(FG)
FG <- gam(
config[["M3"]],
method = "REML",
data = plot_gamdat,
family = gaussian(link = identity)
)
draw(FG)
FG <- gam(
config[["M4"]],
method = "REML",
data = plot_gamdat,
family = gaussian(link = identity)
)
draw(FG)
FG <- gam(
config[["M6"]],
method = "REML",
data = plot_gamdat,
family = gaussian(link = identity)
)
draw(FG)
draw(FG) +theme_bw()
draw(FG) &  theme_bw()
gfcov <- readRDS(COVARIATE_FILE) # covariates
gamdat <- merge(gfcov, gfam, by = "ID")
plot_gamdat <- gamdat[d==1]
FG <- gam(
config[["M6"]],
method = "REML",
data = plot_gamdat,
family = gaussian(link = identity)
)
gfcov[,log_R_G_1085:=log(R_G_1085+1)]
gamdat <- merge(gfcov, gfam, by = "ID")
plot_gamdat <- gamdat[d==1]
FG <- gam(
config[["M6"]],
method = "REML",
data = plot_gamdat,
family = gaussian(link = identity)
)
draw(FG) &  theme_bw()
ggsave(file.path(OUTPUT_DIR,WHICH_DATA_DIR,"apx-interaction-gam-m6.pdf"),
width=8.5,height=9.5,units="in")
FIG_DIR <- file.path(PROJECT_DIR, "results/figures",WHICH_DATA_DIR)
library(gratia)
FIG_DIR <- file.path(PROJECT_DIR, "results/figures",WHICH_DATA_DIR)
gfcov <- readRDS(COVARIATE_FILE) # covariates
gfcov[,log_R_G_1085:=log(R_G_1085+1)]
gamdat <- merge(gfcov, gfam, by = "ID")
plot_gamdat <- gamdat[d==1]
FG <- gam(
config[["M6"]],
method = "REML",
data = plot_gamdat,
family = gaussian(link = identity)
)
draw(FG) &  theme_bw()
ggsave(file.path(FIG_DIR,"apx-interaction-gam-m6.pdf"),
width=8.5,height=9.5,units="in")
ggsave(file.path(FIG_DIR,"apx-interaction-gam-m6.pdf"),
width=10,height=9.5,units="in")
draw(FG) &  theme_bw()
ggsave(file.path(FIG_DIR,"apx-interaction-gam-m6.pdf"),
width=11,height=9.5,units="in")
