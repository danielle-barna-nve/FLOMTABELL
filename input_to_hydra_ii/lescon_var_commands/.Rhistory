permutation_test <- function(ms,modelA,modelB,n_perm = 1000,metric,di=NULL){
## From Thorarinsdottir (2020): Evaluation of CMIP5 and CMIP6...
dt <- copy(ms)
if (!is.null(di)) {
dt <- dt[d == di]
}
avec <- dt[model == modelA, get(metric)]
bvec <- dt[model == modelB, get(metric)]
keep <- is.finite(avec) & is.finite(bvec) # so i can run automatically w xgboost
avec <- avec[keep]
bvec <- bvec[keep]
if (length(avec) == 0 || length(avec) != length(bvec)) {
return(NA_real_)
}
svec = avec-bvec
permvec = rep(NA,n_perm)
for(i in 1:n_perm){
nvec <- sample(c(1,-1),length(avec),replace=T)
permvec[i] <- mean(nvec*svec)
}
s = mean(svec)
percentile <- ecdf(permvec)
quantS <- percentile(s)
return(quantS)
}
# Systematically compare interaction GAMs (M1-M6) against LognormFG
interaction_models <- c("M1", "M2", "M3", "M4", "M5", "M6")
test_metrics <- c("se", "crps", "ae", "re", "ape")
comparison_results <- data.table()
for(model_name in interaction_models){
cat("\n")
print(paste0("===================== ", model_name, " vs LognormFG ====================="))
for(m in test_metrics){
print(paste0("--- Metric: ", m, " ---"))
duration_pvals <- c()
for(di in sort(unique(ptestpred$d))){
p_value <- permutation_test(ptestpred, model_name, "LognormFG", 1000, m, di)
sig <- ifelse(p_value < 0.05, " *", "")
duration_pvals <- c(duration_pvals,
paste0(di, "h: ", round(p_value, 3), sig))
}
print(paste(duration_pvals, collapse = " | "))
# Store results
for(di in sort(unique(ptestpred$d))){
p_value <- permutation_test(ptestpred, model_name, "LognormFG", 1000, m, di)
comparison_results <- rbind(comparison_results,
data.table(model = model_name,
metric = m,
duration = di,
p_value = p_value,
sig = p_value < 0.05))
}
}
}
# Summary table of significant differences (p < 0.05)
setorder(comparison_results, metric, duration, p_value)
print("Summary of significant differences (p < 0.05):")
print(comparison_results[sig == TRUE])
